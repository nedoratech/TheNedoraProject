# ─── Supabase ─────────────────────────────────────────────────────────────────
# Hosted project (Dashboard → Settings → API):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# anon / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role secret — server-only; must NOT be the same value as the anon key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Local stack (`supabase start` — copy keys from `supabase status`):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LANDING_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:3001
NEXT_PUBLIC_CRM_URL=http://localhost:3002

NODE_ENV=development
