{
  "name": "nedora",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:types": "supabase gen types typescript --local > packages/db/src/types.ts",
    "db:types:remote": "supabase gen types typescript --linked > packages/db/src/types.ts",
    "db:reset": "supabase db reset",
    "dev:landing": "turbo dev --filter @nedora/landing",
    "dev:cms": "turbo dev --filter @nedora/microcms",
    "dev:crm": "turbo dev --filter @nedora/microcrm",
    "dev:nedai": "turbo dev --filter @nedora/nedai",
    "build:landing": "turbo build --filter @nedora/landing",
    "build:cms": "turbo build --filter @nedora/microcms",
    "build:crm": "turbo build --filter @nedora/microcrm",
    "build:nedai": "turbo build --filter @nedora/nedai"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "turbo": "^2.5.4",
    "typescript": "^5.7.2"
  },
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": ">=20.9"
  }
}
